{
	"name": "template--next-ts",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"prepare": "husky install"
	},
	"dependencies": {
		"next": "15.2.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@tailwindcss/postcss": "^4.0.15",
		"@types/node": "^20.17.25",
		"@types/react": "^19.0.12",
		"@types/react-dom": "^19.0.4",
		"eslint": "^9.23.0",
		"eslint-config-next": "15.2.3",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.0",
		"pnpm": "^9.15.9",
		"prettier": "^3.5.3",
		"tailwindcss": "^4.0.15",
		"typescript": "^5.8.2"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.ts": [
			"eslint --cache --fix",
			"git add ."
		],
		"*.tsx": [
			"eslint --cache --fix",
			"git add ."
		]
	}
}
